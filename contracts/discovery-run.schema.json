{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hereforwork.local/contracts/discovery-run.v1.schema.json",
  "title": "HereForWork discovery run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "runId",
    "source",
    "coverage",
    "generatedAt",
    "status",
    "findings",
    "issues",
    "integrity"
  ],
  "properties": {
    "contract": { "const": "hereforwork.discovery-run" },
    "schemaVersion": { "const": 1 },
    "runId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "source": { "$ref": "#/$defs/source" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["completed", "partial", "failed"] },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["partial", "failed"] } },
        "required": ["status"]
      },
      "then": { "properties": { "issues": { "minItems": 1 } } }
    },
    {
      "if": {
        "properties": { "status": { "const": "failed" } },
        "required": ["status"]
      },
      "then": { "properties": { "findings": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "displayName", "producer", "producerVersion"],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "producer": { "type": "string", "minLength": 1, "maxLength": 100 },
        "producerVersion": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windowStart", "windowEnd", "timezone"],
      "properties": {
        "windowStart": { "type": "string", "format": "date-time" },
        "windowEnd": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingId",
        "sourceId",
        "source",
        "sourceRoleId",
        "company",
        "title",
        "location",
        "discoveredAt",
        "applicationUrl",
        "normalizedKey",
        "queueGroup",
        "eligibilitySummary",
        "uncertainty",
        "evidence",
        "matchScore"
      ],
      "properties": {
        "findingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "source": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sourceRoleId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "company": { "type": "string", "minLength": 1, "maxLength": 500 },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "location": { "type": "string", "minLength": 1, "maxLength": 500 },
        "discoveredAt": { "type": "string", "format": "date-time" },
        "postedAt": {
          "description": "Source-backed publication date or timestamp. Omit or use null when unavailable.",
          "oneOf": [
            { "type": "string", "format": "date" },
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "applicationUrl": {
          "oneOf": [
            { "type": "string", "format": "uri", "pattern": "^https://" },
            { "type": "null" }
          ]
        },
        "normalizedKey": { "type": "string", "minLength": 3, "maxLength": 500 },
        "queueGroup": { "enum": ["strong_match", "other_new", "needs_decision"] },
        "eligibilitySummary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "uncertainty": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 2000 },
            { "type": "null" }
          ]
        },
        "legitimacy": {
          "enum": ["high_confidence", "proceed_with_caution", "suspicious"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "matchScore": { "$ref": "#/$defs/matchScore" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "kind", "reference", "observedAt"],
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "kind": {
          "enum": [
            "source_listing",
            "company_page",
            "authorization",
            "legitimacy",
            "other"
          ]
        },
        "reference": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "url": {
          "oneOf": [
            { "type": "string", "format": "uri", "pattern": "^https://" },
            { "type": "null" }
          ]
        },
        "observedAt": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "matchScore": {
      "oneOf": [
        { "$ref": "#/$defs/scored" },
        { "$ref": "#/$defs/notScored" }
      ]
    },
    "scored": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scale", "value", "authority", "sourceVersion", "scoredAt"],
      "properties": {
        "status": { "const": "scored" },
        "scale": { "const": "career_ops_1_to_5" },
        "value": { "type": "number", "minimum": 1, "maximum": 5 },
        "authority": { "const": "career-ops" },
        "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 200 },
        "scoredAt": { "type": "string", "format": "date-time" }
      }
    },
    "notScored": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "authority", "sourceVersion", "checkedAt"],
      "properties": {
        "status": { "const": "not_scored" },
        "reason": {
          "enum": ["not_evaluated", "unavailable", "deferred", "insufficient_evidence"]
        },
        "authority": { "const": "career-ops" },
        "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 200 },
        "checkedAt": { "type": "string", "format": "date-time" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueId", "code", "message", "retryable"],
      "properties": {
        "issueId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "code": { "type": "string", "minLength": 1, "maxLength": 200 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "retryable": { "type": "boolean" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "coverage", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "const": "hfw-discovery-run-v1" },
        "coverage": { "const": "all_top_level_fields_except_integrity" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
