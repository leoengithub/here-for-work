{
  "manifest_version": 3,
  "name": "HereForWork Form Assistant",
  "version": "0.1.0",
  "description": "Inspects, fills, and verifies supported job application forms. It never submits.",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": [
    "https://jobs.ashbyhq.com/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "HereForWork",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jobs.ashbyhq.com/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
