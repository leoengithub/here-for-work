{
  "manifest_version": 3,
  "name": "HereForWork Form Assistant",
  "version": "0.1.0",
  "description": "Inspects, safely fills, and verifies web application forms for review. It never submits.",
  "permissions": ["nativeMessaging", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "HereForWork",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
